@api = http://localhost:8000/
@accept-content = application/json
@token = 7f91ad68-6d5f-4f4f-9d7d-5b3481022a45

// User Management

### Create user
POST {{api}}/users
Content-Type: {{accept-content}}

{
    "name": "22",
    "email": "dummy@example.com"
}

### 400, user with this email alread exists
POST {{api}}/users
Content-Type: {{accept-content}}

{
    "name": "dummy",
    "email": "dummy@example.com"
}

### 400, user with this email alread exists
POST {{api}}/users
Content-Type: {{accept-content}}

{
    "name": "dummier",
    "email": "dummy@example.com"
}

### Get user
GET {{api}}/users/1

### 404, user doesn't exist
GET {{api}}//users/2

### 400, invalid user id
GET {{api}}//users/abc


// Location Management

### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Portugal",
    "type": "COUNTRY",
    "parentId": null
}

### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Lisboa",
    "type": "DISTRICT",
    "parentId": 1
}

### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Oeiras",
    "type": "MUNICIPALITY",
    "parentId": 2
}


### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Paço de Arcos",
    "type": "LOCALITY",
    "parentId": 3
}

### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Algés",
    "type": "LOCALITY",
    "parentId": 3
}

### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Barcarena",
    "type": "LOCALITY",
    "parentId": 3
}

### CREATE LOCATION without specifying type gets 400
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Barcarena",
    "parentId": 3
}


### 401, unathorized
POST {{api}}/locations
Content-Type: {{accept-content}}

{
    "name": "Portugal",
    "type": "COUNTRY",
    "parentId": 3
}

### GET location 1
GET {{api}}/locations/1

### GET location 2
GET {{api}}/locations/2

### GET location 3
GET {{api}}/locations/3

### GET location 4
GET {{api}}/locations/4

### GET location with invalid id (400)
GET {{api}}/locations/abc

### GET location 100 (404)
GET {{api}}/locations/100

### Get child locations with invalid id (400)
GET {{api}}/locations/abc/children

### Get child locations with paging
GET {{api}}/locations/3/children?limit=1&skip=1

### Get full hierarchical path
GET {{api}}/locations/4/full

### Get full hierarchical path of non existing id
GET {{api}}/locations/100/full

### Get full hierarchical path of invalid id
GET {{api}}/locations/abc/full


// House Management

### Create house
POST {{api}}/houses
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "title": "T2 com vista para o rio",
    "location": 4,
    "areaSqMt": 80,
    "pricePerNight": 141,
    "description": "Apartemento T2 com vista para o rio. Com 2 quartos duplos, quarto de casal, casa de banho, cozinha e sala."
}

### Create house
POST {{api}}/houses
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "title": "T3 Moradia independente",
    "location": 4,
    "areaSqMt": 88,
    "pricePerNight": 300,
    "description": "T3 Moradia independente com 3 quartos, casa de banho, cozinha e zona de arrumos"
}

### Create house missing parameters in body
POST {{api}}/houses
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "title": "T3 Moradia independente",
    "location": 4,
    "areaSqMt": 88,
    "description": "T3 Moradia independente com 3 quartos, casa de banho, cozinha e zona de arrumos"
}

### Create house without authentication
POST {{api}}/houses
Content-Type: {{accept-content}}

{
    "title": "T3 Moradia independente",
    "location": 4,
    "areaSqMt": 88,
    "pricePerNight": 300,
    "description": "T3 Moradia independente com 3 quartos, casa de banho, cozinha e zona de arrumos"
}

### Get house
GET {{api}}/houses/1

### Get houses
GET {{api}}/houses

### Get houses with paging
GET {{api}}/houses?limit=1&skip=1

### Get houses with incomplete paging returns all results (ignores query)
GET {{api}}/houses?skip=1


// Booking Management

### Create booking
POST {{api}}/bookings
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "hid": 1,
    "startDate": "2025-12-01",
    "endDate": "2025-12-03"
}

### Create booking
POST {{api}}/bookings
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "hid": 2,
    "startDate": "2025-12-07",
    "endDate": "2025-12-11"
}

### Create booking without passing hid (400)
POST {{api}}/bookings
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "startDate": "2025-12-07",
    "endDate": "2025-12-11"
}

### Create booking with non existing hid
POST {{api}}/bookings
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "hid": 1000,
    "startDate": "2025-12-07",
    "endDate": "2025-12-11"
}

### Create booking without authentication
POST {{api}}/bookings
Content-Type: {{accept-content}}

{
    "hid": 2,
    "startDate": "2025-12-07",
    "endDate": "2025-12-11"
}

### Get booking
GET {{api}}/bookings/2

### Get booking for non existing id
GET {{api}}/bookings/1000

### Get booking for invalid id
GET {{api}}/bookings/abc

### Get bookings for interval
GET {{api}}/bookings?hid=1&date-interval=2025-12-01:2025-12-12

### Get bookings for interval with paging
GET {{api}}/bookings?hid=1&date-interval=2025-12-01:2025-12-12&limit=1&skip=0

### Get available houses for date
GET {{api}}/houses/available?startDate=2025-12-04&endDate=2025-12-06

### Get available houses for date without passing required query
GET {{api}}/houses/available?startDate=2025-12-04

### Get available houses for date with paging
GET {{api}}/houses/available?startDate=2025-12-04&endDate=2025-12-06&limit=1&skip=1