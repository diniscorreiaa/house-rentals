@api = http://localhost:8000/
@accept-content = application/json

// Example of how to take data from a response and use it in subsequent requests
// https://www.jetbrains.com/help/idea/http-response-handling-examples.html#script-var-example

// User Management

### Create user
POST {{api}}/users
Content-Type: {{accept-content}}

{
    "name": "22",
    "email": "dummy@example.com"
}
> {% client.global.set("token", response.body.token) %}

### 400, user with this email alread exists
POST {{api}}/users
Content-Type: {{accept-content}}

{
    "name": "dummy",
    "email": "dummy@example.com"
}

### 400, user with this email alread exists
POST {{api}}/users
Content-Type: {{accept-content}}

{
    "name": "dummier",
    "email": "dummy@example.com"
}

### Get user
GET {{api}}/users/
# COLOCAR ERRO 405 EM JSON

### Get user
GET {{api}}/users/1

### Get user bookings
GET {{api}}/users/1/bookings

### 404, user doesn't exist
GET {{api}}//users/2

### 400, invalid user id
GET {{api}}//users/abc


// Location Management

### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Portugal",
    "type": "COUNTRY",
    "parentId": null
}

### Create repeated location (409)
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Portugal",
    "type": "COUNTRY",
    "parentId": null
}

### Create country location with parentId (400)
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Brasil",
    "type": "COUNTRY",
    "parentId": 1
}

### Create location with non existing parentId (404)
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Lisboa",
    "type": "DISTRICT",
    "parentId": 9999
}

### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Lisboa",
    "type": "DISTRICT",
    "parentId": 1
}

### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Oeiras",
    "type": "MUNICIPALITY",
    "parentId": 2
}


### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Paço de Arcos",
    "type": "LOCALITY",
    "parentId": 3
}

### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Algés",
    "type": "LOCALITY",
    "parentId": 3
}

### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Barcarena",
    "type": "LOCALITY",
    "parentId": 3
}

### CREATE LOCATION without specifying type gets 400
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Barcarena",
    "parentId": 3
}


### 401, unathorized
POST {{api}}/locations
Content-Type: {{accept-content}}

{
    "name": "Portugal",
    "type": "COUNTRY",
    "parentId": 3
}

### GET location 1
GET {{api}}/locations/1

### GET location 2
GET {{api}}/locations/2

### GET location 3
GET {{api}}/locations/3

### GET location 4
GET {{api}}/locations/4

### GET location with invalid id (400)
GET {{api}}/locations/abc

### GET location 100 (404)
GET {{api}}/locations/100

### Get child locations with invalid id (400)
GET {{api}}/locations/abc/children

### Get child locations with paging
GET {{api}}/locations/3/children?limit=1&skip=1

### Get full hierarchical path
GET {{api}}/locations/4/full

### Get full hierarchical path of non existing id
GET {{api}}/locations/100/full

### Get full hierarchical path of invalid id
GET {{api}}/locations/abc/full


// House Management

### Create house
POST {{api}}/houses
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "title": "T2 com vista para o rio",
    "location": 4,
    "areaSqMt": 80,
    "pricePerNight": 141,
    "description": "Apartamento T2 com vista para o rio. Com 2 quartos duplos, quarto de casal, casa de banho, cozinha e sala."
}

### Create house
POST {{api}}/houses
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "title": "T3 Moradia independente",
    "location": 4,
    "areaSqMt": 88,
    "pricePerNight": 300,
    "description": "T3 Moradia independente com 3 quartos, casa de banho, cozinha e zona de arrumos"
}

### Create house missing parameters in body
POST {{api}}/houses
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "title": "T3 Moradia independente",
    "location": 4,
    "areaSqMt": 88,
    "description": "T3 Moradia independente com 3 quartos, casa de banho, cozinha e zona de arrumos"
}

### Create house without authentication
POST {{api}}/houses
Content-Type: {{accept-content}}

{
    "title": "T3 Moradia independente",
    "location": 4,
    "areaSqMt": 88,
    "pricePerNight": 300,
    "description": "T3 Moradia independente com 3 quartos, casa de banho, cozinha e zona de arrumos"
}

### Get house
GET {{api}}/houses/1

### Get houses
GET {{api}}/houses

### Get houses with paging
GET {{api}}/houses?limit=1&skip=1

### Get houses with incomplete paging returns all results (ignores query)
GET {{api}}/houses?skip=1

### Get available houses
GET {{api}}/houses/available?startDate=2025-10-10&endDate=2026-05-10


// Booking Management

### Create booking
POST {{api}}/bookings
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "hid": 1,
    "startDate": "2027-07-01",
    "endDate": "2027-08-03"
}

### Create booking
POST {{api}}/bookings
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "hid": 2,
    "startDate": "2025-12-07",
    "endDate": "2025-12-11"
}

### Create booking with wrong date format
POST {{api}}/bookings
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "hid": 1,
    "startDate": "2026-1-01",
    "endDate": "2026-1-03"
}

### Create booking without passing hid (400)
POST {{api}}/bookings
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "startDate": "2025-12-07",
    "endDate": "2025-12-11"
}

### Create booking with non existing hid
POST {{api}}/bookings
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "hid": 1000,
    "startDate": "2025-12-07",
    "endDate": "2025-12-11"
}

### Create booking without authentication
POST {{api}}/bookings
Content-Type: {{accept-content}}

{
    "hid": 2,
    "startDate": "2025-12-07",
    "endDate": "2025-12-11"
}

### Get booking
GET {{api}}/bookings/2

### Get booking for non existing id
GET {{api}}/bookings/1000

### Get booking for invalid id
GET {{api}}/bookings/abc

### Get bookings for interval
GET {{api}}/bookings?hid=1&date-interval=2025-12-01:2028-12-12

### Get bookings for interval with paging
GET {{api}}/bookings?hid=1&date-interval=2025-12-01:2025-12-12&limit=1&skip=0

### Get available houses for date
GET {{api}}/houses/available?startDate=2025-12-04&endDate=2025-12-06

### Get available houses for date without passing required query
GET {{api}}/houses/available?startDate=2025-12-04

### Get available houses for date with paging
GET {{api}}/houses/available?startDate=2025-12-04&endDate=2025-12-06&limit=1&skip=1

### Get bookings of user 1
GET {{api}}/users/1/bookings

### Get bookings of user 2
GET {{api}}/users/2/bookings

### Get bookings of non existent user (404)
GET {{api}}/users/999999/bookings

### Get bookings of invalid id (400)
GET {{api}}/users/abca/bookings

### Get available days for booking of house 2 with limit 10
GET {{api}}/houses/2/daysAvailable?month=12&year=2025&limit=10

### Update booking 1
PUT {{api}}/bookings/1
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "startDate": "2026-05-01",
    "endDate": "2026-05-05"
}

### Update booking 2
PUT {{api}}/bookings/2
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "startDate": "2026-05-01",
    "endDate": "2026-05-05"
}

### Update booking with wrong date format
PUT {{api}}/bookings/1
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "startDate": "2026-5-1",
    "endDate": "2026-5-5"
}

### Update booking without authentication (401)
PUT {{api}}/bookings/2
Content-Type: {{accept-content}}

{
    "startDate": "2026-05-01",
    "endDate": "2026-05-05"
}

### Update booking passing wrong date format
PUT {{api}}/bookings/2
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "startDate": "2026-5-01",
    "endDate": "2026-5-05"
}

### Delete booking without authentication
DELETE {{api}}/bookings/1

### Delete booking 1
DELETE {{api}}/bookings/1
Authorization: {{token}}

### Delete booking 2
DELETE {{api}}/bookings/2
Authorization: {{token}}