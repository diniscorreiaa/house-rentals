@api = http://localhost:8000/
@accept-content = application/json
@token = 6f3f17be-d2f8-4787-b85c-4ed65853d282

// User Management

### Create user
POST {{api}}/users
Content-Type: {{accept-content}}

{
    "name": "22",
    "email": "dummy@example.com"
}

### 400, user with this email alread exists
POST {{api}}/users
Content-Type: {{accept-content}}

{
    "name": "dummy",
    "email": "dummy@example.com"
}

### 400, user with this email alread exists
POST {{api}}/users
Content-Type: {{accept-content}}

{
    "name": "dummier",
    "email": "dummy@example.com"
}

### Get user
GET {{api}}/users/1

### 404, user doesn't exist
GET {{api}}//users/2


// Location Management

### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Portugal",
    "type": "COUNTRY",
    "parentId": null
}

### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Lisboa",
    "type": "DISTRICT",
    "parentId": 1
}

### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Oeiras",
    "type": "MUNICIPALITY",
    "parentId": 2
}


### CREATE LOCATION
POST {{api}}/locations
Content-Type: {{accept-content}}
