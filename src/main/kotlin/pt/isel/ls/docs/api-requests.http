Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "name": "Barcarena",
    "type": "LOCALITY",
    "parentId": 3
}


### 401, unathorized
POST {{api}}/locations
Content-Type: {{accept-content}}

{
    "name": "Portugal",
    "type": "COUNTRY",
    "parentId": 3
}

### GET location 1
GET {{api}}/locations/1

### GET location 2
GET {{api}}/locations/2

### GET location 3
GET {{api}}/locations/3

### GET location 4
GET {{api}}/locations/4

### GET location 100
GET {{api}}/locations/100

### Get child locations
GET {{api}}/locations/3/children

### Get full hierarchical path
GET {{api}}/locations/4/full


// House Management

### Create house
POST {{api}}/houses
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "title": "T2 com vista para o rio",
    "location": 4,
    "areaSqMt": 80,
    "pricePerNight": 141,
    "description": "Apartemento T2 com vista para o rio. Com 2 quartos duplos, quarto de casal, casa de banho, cozinha e sala."
}

### Create house
POST {{api}}/houses
Content-Type: {{accept-content}}
Authorization: {{token}}

{
    "title": "T3 Moradia independente",
    "location": 4,
    "areaSqMt": 88,
    "pricePerNight": 300,
    "description": "T3 Moradia independente com 3 quartos, casa de banho, cozinha e zona de arrumos"
}

### Get house
GET {{api}}/houses/1

### Get house
GET {{api}}/houses


